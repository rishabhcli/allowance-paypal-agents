# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# AG Studio licence key (45 day trial: https://www.ag-grid.com/studio/react/enterprise-licence/). Without it Studio runs with a watermark.
AG_STUDIO=

# --- Allowance ---
# Channel3 product search for the shopping agent (https://trychannel3.com/developers, promo PAYPAL-HACKATHON-2026).
CHANNEL3_API_KEY=
# Fireworks serves the agent's model through an OpenAI-compatible API.
FIREWORKS_API_KEY=
AGENT_MODEL=accounts/fireworks/models/gpt-oss-120b
# card (default): authorize with a PayPal sandbox test card in one call. wallet: stop at the PayPal approval URL.
PAYPAL_FUNDING=card
APP_BASE_URL=http://localhost:3000
# Set after registering the webhook (see README). Without it the webhook route refuses events.
PAYPAL_WEBHOOK_ID=
